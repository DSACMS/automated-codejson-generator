{
  "name": "automated-codejson-generator",
  "description": "GitHub Action that generates and maintains code.json metadata files",
  "version": "0.0.0",
  "author": "DSACMS",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/DSACMS/automated-codejson-generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DSACMS/automated-codejson-generator.git"
  },
  "bugs": {
    "url": "https://github.com/DSACMS/automated-codejson-generator/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx local-action . src/main.ts .env",
    "package": "npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package",
    "update-gov-dependencies": "npx tsx src/gov-update/run.ts"
  },
  "license": "CC0-1.0",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@octokit/action": "^8.0.4",
    "codejson-core": "^0.3.0",
    "node-llama-cpp": "3.21.1",
    "octokit-plugin-create-pull-request": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@github/local-action": "^7.0.0",
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.37",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "rollup": "^4.64.6",
    "ts-jest": "^29.4.14",
    "ts-jest-resolver": "^2.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "overrides": {
    "undici": "^6.28.1"
  }
}
